{"shiwilu": "llinserchutek' nuka'ka", "spanish": "soy escritor."}
{"shiwilu": "yaweyta", "spanish": "no engordes."}
{"shiwilu": "¡ta'itula'u'ku yapanta'lek!", "spanish": "¡déjeme ir!"}
{"shiwilu": "panuerken", "spanish": "te premiaré."}
{"shiwilu": "tekinchi nuka'a", "spanish": "tienes razón."}
{"shiwilu": "uker'echu", "spanish": "se quemará."}
{"shiwilu": "musu' wintu'u", "spanish": "explícamelo."}
{"shiwilu": "- uk'apincha'lek yalli'amun. pa'amu menmik u'dun uklli lli'ker'i'ñen.", "spanish": "estoy viniendo queriendo verte. como fui a la chacra tantos días no te he visitado."}
{"shiwilu": "¿kenmashasa' ñapala?", "spanish": "¿estás sola?"}
{"shiwilu": "ek'ker'cher'", "spanish": "ábrela."}
{"shiwilu": "tom lun'echu", "spanish": "tom hablará."}
{"shiwilu": "ta'itula'u lek'techek", "spanish": "déjame averiguarlo."}
{"shiwilu": "¿enpi'teke'chu?", "spanish": "¿cuándo correrás?"}
{"shiwilu": "intek apalli", "spanish": "está fingiendo."}
{"shiwilu": "u'chimu'ñiwiñi", "spanish": "era fabuloso."}
{"shiwilu": "iñer'daper' mallia'llina'", "spanish": "todos oraron."}
{"shiwilu": "nu'amu kua wa'inutulek.", "spanish": "por eso tengo pena."}
{"shiwilu": "nanpi'palek'i'la", "spanish": "sigo vivo."}
{"shiwilu": "ta'itula'u ata'wantak", "spanish": "déjame terminar."}
{"shiwilu": "di'tulli lanla'.", "spanish": "él mató a la ballena."}
{"shiwilu": "saka'tapallina'", "spanish": "están trabajando."}
{"shiwilu": "nawa dekllina'", "spanish": "ellos votaron."}
{"shiwilu": "brashika nuka'a", "spanish": "es brasileña."}
{"shiwilu": "dadapu nuka'a", "spanish": "es blanco."}
{"shiwilu": "ala'sa' yalli' ektukerlli", "spanish": "alguien llegó."}
{"shiwilu": "naneklimaka asu' nana lanla' pitunta' uwentunta'lli.", "spanish": "de ahí, esta la ballena poza se redujo."}
{"shiwilu": "kualek ñapallina'", "spanish": "están conmigo."}
{"shiwilu": "asu' yekpantan wei ali'la ñinanluk yañinchitula, ma'pu'sui'pa nanpilek kua asu' shiwiluk.", "spanish": "esto queriendo llevar lejos, a otro pueblo, quieres aprender, de qué manera vivo aquí en jeberos."}
{"shiwilu": "luwerchinpu'deker", "spanish": "ignoralos."}
{"shiwilu": "ekpa'ker' utila'", "spanish": "conduce lentamente."}
{"shiwilu": "¿kenma latektapala?", "spanish": "¿tú crees?"}
{"shiwilu": "ñinchitapalek tuluner'ak", "spanish": "puedo cantar."}
{"shiwilu": "yunsu'lek", "spanish": "salí."}
{"shiwilu": "¿enñupa'cha ñapalek?", "spanish": "¿dónde estoy?"}
{"shiwilu": "ta'itula'u inlli'inutechek", "spanish": "déjame pensar."}
{"shiwilu": "nawa' katu'pa'techuna'", "spanish": "ellos ayudarán."}
{"shiwilu": "shiwilu la'la' yañinchitulli.", "spanish": "quiere aprender el idioma shiwilu."}
{"shiwilu": "¡iyasu' lanelliek!", "spanish": "¡huele rico!"}
{"shiwilu": "tom katu'pa'techu", "spanish": "tom ayudará."}
{"shiwilu": "wa'tentutek nuka'ma", "spanish": "eres paciente."}
{"shiwilu": "itununta'u", "spanish": "repítemelo."}
{"shiwilu": "analli", "spanish": "apesta."}
{"shiwilu": "wa'an tullima nanek, nanek wa'an ñiwiñi.", "spanish": "dice que ahí había una autoridad, ahí había gobernante."}
{"shiwilu": "malallina nana nu'su' a'kankantullundek,", "spanish": "malallina es la que nos ha hecho reflexionar,"}
{"shiwilu": "napi'da' nuka'a", "spanish": "es viejo."}
{"shiwilu": "ñinchitapallidek", "spanish": "lo sabemos."}
{"shiwilu": "¿mapu'la?", "spanish": "¿qué pasa?"}
{"shiwilu": "kuda ekpekchidek", "spanish": "nosotros conduciremos."}
{"shiwilu": "ipa' dei'tulamau'ku, ipa' kekkapalama'u'ku lli'chinpuek a'pinta'.", "spanish": "ya me han muerto, ya me están quemando para que no vea más nada."}
{"shiwilu": "¿ikerli?", "spanish": "¿es doloroso?"}
{"shiwilu": "inapilante'ñapalek", "spanish": "estoy descalzo."}
{"shiwilu": "enchuku', inlli'inuku'la' yalli'lusa' enpu'ninchi yawichi'tama' nanpiladaku'.", "spanish": "vamos, prevénganse hermanos, no duerman mucho, han de velar en la noche."}
{"shiwilu": "ka'a'kawa'su' ñapalli", "spanish": "deberíamos comer."}
{"shiwilu": "nu'tulek kai kualusa', senñula'lusa',", "spanish": "así se hace hermanas, señoras,"}
{"shiwilu": "¿luwer'chapallien?", "spanish": "¿te conozco?"}
{"shiwilu": "kenma lli'ker'", "spanish": "encárgate tú."}
{"shiwilu": "wa'tentechek", "spanish": "esperaré."}
{"shiwilu": "a'wer'llidek", "spanish": "los perdimos."}
{"shiwilu": "pitawilek ma'ilek nerku'teklek pitawilek.", "spanish": "se lo va batiendo con este. con un remo se lo bate."}
{"shiwilu": "tullima nana ala'sa' taserpi wa'lata'su', lunanpichita'su'.", "spanish": "dijo ese viejo soñador, que predecía lo que iba a suceder."}
{"shiwilu": "latek'tutek nuka'ka", "spanish": "soy responsable."}
{"shiwilu": "nawa' ñinanlu'nenna' a'llupitununtekchuna' itullima tanpen muda'.", "spanish": "sólo el pueblo de ellos se reproducirá le dijo al hombre candela."}
{"shiwilu": "tom nakusu' a'teka'lli", "spanish": "tom aceleró."}
{"shiwilu": "¡tuku' ma'nen'unta'!", "spanish": "¡digan algo!"}
{"shiwilu": "arakayuler pekkun pa'lapinta'lli.", "spanish": "arakayú icaró y se fue dejándolos."}
{"shiwilu": "nana yapanti'npu'lusa', enpu'dunshipa' llia'llina'.", "spanish": "los que no quisieron ir río abajo, unos cuantos se quedaron."}
{"shiwilu": "enka'u nu'unta'lusa'", "spanish": "dame algunos."}
{"shiwilu": "mape'chek", "spanish": "lo compraré."}
{"shiwilu": "ma'pu'sin", "spanish": "hola."}
{"shiwilu": "- nanekla yunsanma' tekka'nta'ku' ala'sa' nala inner'apek walek.", "spanish": "después levántense y corran hasta un árbol inclinado."}
{"shiwilu": "a'chiyek'echiden", "spanish": "te salvaremos."}
{"shiwilu": "yateklerilek", "spanish": "quiero intentarlo."}
{"shiwilu": "amercha tekuasu' ñapalek", "spanish": "estoy nervioso."}
{"shiwilu": "amana' ñichu di'tawa', ali'la erpilu' kupiwan ñipachi nananta' di'tawa'.", "spanish": "si hay tigre se lo mata, si hay anaconda de altura a esa también se la mata."}
{"shiwilu": "¿yennitulama katupa'a'muk?", "spanish": "¿pueden ayudarme?"}
{"shiwilu": "tom ektu'lli", "spanish": "tom llegó."}
{"shiwilu": "ma'nen' ñi'ñi lun'ak'", "spanish": "sin comentarios."}
{"shiwilu": "nanekla'nka lawektapamudek kudanta' ipa'la walek lli'inutapallidek nana lunka'su'.", "spanish": "de ahí, escuchándoles, nosotros también hasta ahora nos acordamos de eso que hablaban."}
{"shiwilu": "kua katu'patulek", "spanish": "yo contribuí."}
{"shiwilu": "tom lli'inutulli", "spanish": "tom recordó."}
{"shiwilu": "ta'itula'llina'", "spanish": "cancelaron."}
{"shiwilu": "¿nanek ñapawina?", "spanish": "¿estabas allí?"}
{"shiwilu": "lauk'echen", "spanish": "te escucharé."}
{"shiwilu": "eksu', kencha'lek pidik, aku'lek.", "spanish": "pelada, se trae a la casa y se la guarda."}
{"shiwilu": "yachiminek", "spanish": "quiero morir."}
{"shiwilu": "inmusha'wa'", "spanish": "besémonos."}
{"shiwilu": "saka'tapalli musu'", "spanish": "funciona bien."}
{"shiwilu": "tom lli'inutapalli", "spanish": "tom recuerda."}
{"shiwilu": "we'inu", "spanish": "lo siento."}
{"shiwilu": "luyulek idenmaak", "spanish": "odio pelear."}
{"shiwilu": "asek uk'apilellina'", "spanish": "aquí vienen."}
{"shiwilu": "yinnitullidek katu'pa'tak", "spanish": "podemos ayudar."}
{"shiwilu": "kua wek'amu suktasa' willaweklusa' a'ñilek.", "spanish": "viniendo he tenido sólo seis hijos."}
{"shiwilu": "wilawamui'na nawa' lli'apallinerku, uran'ukeklan3, uweklan, iñerkeklan lli'apallinerku wilaweklusa'.", "spanish": "pero como tengo hijos ellos me están viendo, de mi comida, de mi bebida, de todo me están viendo mis hijos."}
{"shiwilu": "¡katu'pa'!", "spanish": "¡ayuda!"}
{"shiwilu": "yalansa'lek", "spanish": "quiero bailar."}
{"shiwilu": "nana katu'patulli", "spanish": "eso ayuda."}
{"shiwilu": "kadu'lusa' nuker'ka", "spanish": "son huevos."}
{"shiwilu": "yamerladallina'", "spanish": "sonrieron."}
{"shiwilu": "insek'diperpi ñape'chu", "spanish": "estará listo."}
{"shiwilu": "iñer' luantulek wapu'", "spanish": "soy codicioso."}
{"shiwilu": "napi' i'na amiku'lusa' utawitunanteklek utawillina'.", "spanish": "pero anteriormente las abuelas finadas batían con el batidor utawitunantek."}
{"shiwilu": "yaekpa'lek", "spanish": "quiero manejar."}
{"shiwilu": "enta'n lunchek ipa'la asu' ma'pu'sui'pa' kankantanna' shiwiluku'lusa' muyunpa yaluwetchullina'.", "spanish": "a ver pues, voy a contar ahora cómo se les habrá ocurrido a los shiwilu finados conocer moyobamba."}
{"shiwilu": "yennitula lun'a'mak", "spanish": "puedes hablar."}
{"shiwilu": "tumu'tulek", "spanish": "le burlé."}
{"shiwilu": "katu'palek", "spanish": "le ayudo."}
{"shiwilu": "lliya'lek'", "spanish": "me quedé."}
{"shiwilu": "kudi'na ta'tushala'mudek kawidekllidek yalaukdek'amudek.", "spanish": "nosotros silenciosamente nos acercábamos queriendo escuchar."}
{"shiwilu": "napi', kuanta' wilakuñamu laukta'kasu' nana muyunpa inchilalak taker'llina', lansi' wa'danler ka'deklli tullina'.", "spanish": "antes cuando yo era niño he escuchado que en ese camino de moyobamba perecieron, el duende puro hueso les comió dijeron."}
{"shiwilu": "insek'diperlekwa'", "spanish": "nos preparamos."}
{"shiwilu": "arakayuler itudeklli:", "spanish": "arakayu les dijo:"}
{"shiwilu": "empu'ni yalunta'", "spanish": "sea breve."}
{"shiwilu": "tom akusute'chu", "spanish": "tom cocinará."}
{"shiwilu": "nana sekputchek ima nana mukankinpu'a'su'.", "spanish": "sekputchek no era de buen corazón."}
{"shiwilu": "saka'tullina' nakusu'", "spanish": "trabajan mucho."}
{"shiwilu": "nanekla mushasu' inkawilalek, inpamu'lateklek.", "spanish": "después bonito se lava uno la boca y se lava los dientes."}
{"shiwilu": "yanu'tapala", "spanish": "estás tratando."}
{"shiwilu": "¿ñapala?", "spanish": "¿estás?"}
{"shiwilu": "a'teradek'awa' asu' kenma'lusa'.", "spanish": "hay que hacerles sembrar a estos indios."}
{"shiwilu": "¿insek'diperpi ñapala?", "spanish": "¿estás lista?"}
{"shiwilu": "yusu' ñapallina'", "spanish": "están enojados."}
{"shiwilu": "nawa' inyutullina'", "spanish": "ellos discutieron."}
{"shiwilu": "tom mermiñi", "spanish": "tom gruñó."}
{"shiwilu": "wa'ten'u nanpisu'", "spanish": "espérame despierto."}
{"shiwilu": "¡lau'ker', wa'tenter'!", "spanish": "¡oye, aguarda!"}
{"shiwilu": "kanandeklek", "spanish": "los encontré."}
{"shiwilu": "alli'echen", "spanish": "te mostraré."}
{"shiwilu": "denlekpin'ta' ñapala", "spanish": "eres parcial."}
{"shiwilu": "lli'tullina' musu'", "spanish": "parecen felices."}
{"shiwilu": "a'nañiechidek", "spanish": "compartiremos."}
{"shiwilu": "wa'tentechu", "spanish": "esperará."}
{"shiwilu": "lumpawiñidek", "spanish": "estábamos hablando."}
{"shiwilu": "kua panwilek'te'chek'", "spanish": "yo pagaré."}
{"shiwilu": "¿mudinupallincha?", "spanish": "¿está sano?"}
{"shiwilu": "luyullien", "spanish": "te detesto."}
{"shiwilu": "intek weranpalli", "spanish": "está fingiendo comer."}
{"shiwilu": "ipa'la'ka luwetchudekllina' ali'la muda'lusa', luwetchudekñina' nerpi'la lunlusa'.", "spanish": "ahora conocemos a otras gentes, conocemos a los que hablan otra lengua."}
{"shiwilu": "¡dakuta'lek!", "spanish": "¡qué vergüenza!"}
{"shiwilu": "yupa'masu'pu'su' lli'tula", "spanish": "pareces molesto."}
{"shiwilu": "welliek'apallidek", "spanish": "estamos llorando."}
{"shiwilu": "intekleriaper'ila", "spanish": "sigue intentando."}
{"shiwilu": "wer'llidek", "spanish": "perdimos."}
{"shiwilu": "luwantullina' kulliker", "spanish": "necesitan dinero."}
{"shiwilu": "nakulli", "spanish": "pasó."}
{"shiwilu": "ka'apalek wayupi", "spanish": "como fruta."}
{"shiwilu": "kadulunsu' ñapalek", "spanish": "estoy embarazada."}
{"shiwilu": "nu'ter' ipia'la", "spanish": "hazlo ahorita."}
{"shiwilu": "nu'unta'nmu'wa' ipa' muyunpa luwetchaterwa'.", "spanish": "tal vez algunos de nosotros vamos a conocer moyobamba."}
{"shiwilu": "naneklima shawalalusa'ler itullina':", "spanish": "de ahí los shawala le dijeron:"}
{"shiwilu": "¿yennitulek lli'dek'ak?", "spanish": "¿puedo verlos?"}
{"shiwilu": "sapusu' ñapalli", "spanish": "está arruinado."}
{"shiwilu": "llia'ker' kualek", "spanish": "quedate conmigo."}
{"shiwilu": "¿mer'su' ñapala?", "spanish": "¿estás lleno?"}
{"shiwilu": "¿luwer'chapalama'u?", "spanish": "¿me conocen?"}
{"shiwilu": "a'ta'wantulek", "spanish": "he terminado."}
{"shiwilu": "¡wiuk'ku wilalusa'!", "spanish": "¡apúrensen, muchachos!"}
{"shiwilu": "tekua'dansu' ñapalek", "spanish": "estoy horrorizado."}
{"shiwilu": "wer'su' ñapalek", "spanish": "estoy perdida."}
{"shiwilu": "a'pawilek'ker'", "spanish": "reemplázalo."}
{"shiwilu": "¡wiuku' wilalunlusa!", "spanish": "¡apúrensen, muchachas!"}
{"shiwilu": "¿peklu'tula?", "spanish": "¿llamaste?"}
{"shiwilu": "kenmu'wa' a'pinta' tu'aper'interwa'. kenmu'wa' a'pinta' usha'winterwa'.", "spanish": "nosotros no vamos a equivocarnos más. nosotros no vamos a pecar más."}
{"shiwilu": "ukilasu'tundek enñi,", "spanish": "el rayo caño se secó,"}
{"shiwilu": "ninchichi'nek", "spanish": "ni idea."}
{"shiwilu": "a'aper'lek'", "spanish": "fracasé."}
{"shiwilu": "ipi'ma nana ukalu' yata'wanta'su'lupa' ima, uk'apilincha', nanek kapeklli ala'sa' enmu'pinen nadi'nek piperunkallu'la'su', pipelladasu'. cuando iban terminando ese bajial, cuando venían, allí encontraron a", "spanish": "un hombre joven de cuello colorado y cara colorada."}
{"shiwilu": "aper'la", "spanish": "fallaste."}
{"shiwilu": "tekkinchima ala'simana' sekllintapilanna' ektu'llina' ala'sa' kupin mutupi.", "spanish": "de verdad una semana iban abriendo trocha y llegaron a una loma grande."}
{"shiwilu": "naneklimaka, pacher kencha'llina' apetchanna' dekpilli.", "spanish": "cuentan que de ahí se trajeron al cura raptándolo por la noche."}
{"shiwilu": "kana'llidek", "spanish": "ganamos."}
{"shiwilu": "- panuudek sametchapen. uki'lallidek.", "spanish": "regálanos tus pescaditos. tenemos hambre."}
{"shiwilu": "u'chimuinchi ¿i'ya?", "spanish": "genial, ¿no?"}
{"shiwilu": "amilusa' wa'inutullina', willekllina'.", "spanish": "las viejitas tenían mucha pena y lloraban."}
{"shiwilu": "amennan nuka'ka", "spanish": "soy zurdo."}
{"shiwilu": "nu'sik nu'eklima nana muyunpak ektu'llina' tullina' papinkuku'lusa'.", "spanish": "así, de esa manera, llegaron a moyobamba decían los abuelos ya finados."}
{"shiwilu": "a'ñapallidek vinu'", "spanish": "tenemos vino."}
{"shiwilu": "llia'ker' nanek", "spanish": "detente ahí."}
{"shiwilu": "aperlliner'kudek", "spanish": "nos robaron."}
{"shiwilu": "yamerku'", "spanish": "sonrían."}
{"shiwilu": "kana'tulek", "spanish": "gané."}
{"shiwilu": "¿suntadulusa'cha?", "spanish": "¿son polis?"}
{"shiwilu": "tullini'ma ali'ladaper.", "spanish": "dijeron otras."}
{"shiwilu": "a'pinta' musenkek", "spanish": "más alto."}
{"shiwilu": "¡wanerker'!", "spanish": "¡de pie!"}
{"shiwilu": "¡yuspeinet'echun nanapu'si'la!", "spanish": "¡gracias nuevamente!"}
{"shiwilu": "ali'la musu'nti'ma pa'lli nanalupa'pi'la, yaluwerkun. adencha'n nananta' luncha'lli.", "spanish": "otro grupo se fue por ahí mismo queriendo conocer. volviendo ellos también hablaron."}
{"shiwilu": "ipa'li'na kai kuaweklusa', senñula'lusa', wintetchenma'", "spanish": "ahora mis hermanas menores, señoras, les voy a contar,"}
{"shiwilu": "nuka'kawa taserpilusa'", "spanish": "somos adultos."}
{"shiwilu": "mumu'wanbalek", "spanish": "¡qué equipo!"}
{"shiwilu": "¿nana wenche'chu?", "spanish": "¿ella vendrá?"}
{"shiwilu": "¿wer'su' ñapala?", "spanish": "¿estás perdido?"}
{"shiwilu": "¿yennitulek ek'llia'ak?", "spanish": "¿puedo quedármelo?"}
{"shiwilu": "chiminllinkekla nampilli", "spanish": "sobrevivió."}
{"shiwilu": "nawa'ler ima aku'llillillina' laweklatek.", "spanish": "ellos han adoptado el nombre el de la boca abierta."}
{"shiwilu": "¡enñupa' ñinanlu' ipa' pa'achuma'! ali'la ñinanlu'lupa' pa'achuma', muyunpalupa' a'pinta' pa'api'nchuma'.", "spanish": "¡a que ciudad quizá van a ir! a otra ciudad desconocida van a ir, a moyobamba ya no van a ir más."}
{"shiwilu": "latek'iñen", "spanish": "lo dudo."}
{"shiwilu": "werampalek", "spanish": "estoy comiendo."}
{"shiwilu": "nu'su'sa' ñillina' napi'.", "spanish": "así nomas han sido antes."}
{"shiwilu": "asu' saka'tapalli", "spanish": "esto trabaja."}
{"shiwilu": "asek' ñapalli", "spanish": "aquí está."}
{"shiwilu": "patenchulek", "spanish": "lo abofeteé."}
{"shiwilu": "nu'sui'ma asu' panpadek uksu'ketchulli.", "spanish": "así dicen que pampayacu se quemó."}
{"shiwilu": "lau'tapalek", "spanish": "estoy escuchando."}
{"shiwilu": "ma'pu'sui'na ikellandu'mu innichi'nek dekkunta'kasu'.", "spanish": "como ahora con este dolor de pierna no puedo caminar."}
{"shiwilu": "linserchapalek la'la'lusa'", "spanish": "escribo versos."}
{"shiwilu": "nu'anna' eklli pur'awa' tullini'ma.", "spanish": "luego de hacer eso, dijeron pesquemos mañana."}
{"shiwilu": "nu'unta' ima lanpi'tasu' nana pendalu' penlu'pasu'. nanekla ima ñilli kuwer', tuner, dudinpu' kaluwi' ñilli merpimapu'wek tullina'.", "spanish": "algunos percibieron la ceniza que volaba. dicen que de ahí se originó la lombriz, el iluli, toda clase de enfermedades que hay en nuestro estómago, dijeron."}
{"shiwilu": "nana taserpitulli", "spanish": "él envejeció."}
{"shiwilu": "¿tupitechunku?", "spanish": "¿me sigues?"}
{"shiwilu": "utrinwanpalek", "spanish": "tengo hermanas."}
{"shiwilu": "lauk'tawa'", "spanish": "escuchemos."}
{"shiwilu": "wa'danpintek ñapalek", "spanish": "estoy loco."}
{"shiwilu": "wei ek'tue'chuna'", "spanish": "llegaran lejos."}
{"shiwilu": "tumu'llina'", "spanish": "engañaron."}
{"shiwilu": "kua ipa' wa'latulek.", "spanish": "yo ya he soñado."}
{"shiwilu": "uklupidekkin yañinchitulama'.", "spanish": "de la chicha punta quieren conocer."}
{"shiwilu": "¿yennitula uk'a'mak?", "spanish": "¿puedes venir?"}
{"shiwilu": "kaikshawekleksa' llia'lek.", "spanish": "con mi hermana mayor nomás me quedé."}
