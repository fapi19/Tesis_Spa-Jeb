{"shiwilu": "¿yennitula yunsan'a'mak?", "spanish": "¿puedes levantarte?"}
{"shiwilu": "lauk'i'nek", "spanish": "no escuché."}
{"shiwilu": "enka'ku'", "spanish": "¡pásenle!"}
{"shiwilu": "yamercha", "spanish": "sé serio."}
{"shiwilu": "wa'tentullina'", "spanish": "esperaron."}
{"shiwilu": "ñapallidek wintensu'", "spanish": "estamos colgados."}
{"shiwilu": "nanadaper a'ñapallidek", "spanish": "tenemos esos."}
{"shiwilu": "ta'ituler' pa'i", "spanish": "déjalo ir."}
{"shiwilu": "yampu'su' ñapallidek", "spanish": "estamos separados."}
{"shiwilu": "nana nu'apasik ima di'serpidektullina'.", "spanish": "mientras pasaba eso dice quemaron la casa."}
{"shiwilu": "¡enchuku' pa'awa'! nupullini'ma ñinanluklan.", "spanish": "¡vayamos! y salieron en grupos desde el pueblo."}
{"shiwilu": "nana saka'tapalli", "spanish": "eso funciona."}
{"shiwilu": "ipa'la'ka tullima ala'sa' taserpi ipa' asu'nta'ka ka'nansinmu'wa' kenmu'wa' inlli'inuinpu'a'kawa'su' ñilli.", "spanish": "entonces un hombre viejo dijo: ahora sí éste ya nos hubiera comido a nosotros si no nos hubiéramos prevenido."}
{"shiwilu": "¿yennitapala dekkunta'mak?", "spanish": "¿puedes andar?"}
{"shiwilu": "luyu'lli teka'ak", "spanish": "odia correr."}
{"shiwilu": "¿musu'?", "spanish": "¿contento?"}
{"shiwilu": "¿nusha'tusu' ñapalli?", "spanish": "¿está roto?"}
{"shiwilu": "nu'sik ker' su'watek nananta' a'ukluka'lek ali'la uktak.", "spanish": "así también yuca cruda rallada también se hierve en otra olla."}
{"shiwilu": "wilawek wilamapu'wa'lusa' lli'erkek, nawa'nta' luwetcherkek.", "spanish": "para que mis hijos y los hijos de todos nosotros lo lean y que ellos también conozcan."}
{"shiwilu": "tom si'lentulli", "spanish": "tom vaciló."}
{"shiwilu": "ekte'chechuna'", "spanish": "se adelantarán."}
{"shiwilu": "kuashasa' ñapalek", "spanish": "estoy solo."}
{"shiwilu": "luwantulek wichi'ak", "spanish": "necesito dormir."}
{"shiwilu": "wencher' asek", "spanish": "ven acá."}
{"shiwilu": "¿nu'la'lli?", "spanish": "¿es grave?"}
{"shiwilu": "lau'tulek", "spanish": "escuché."}
{"shiwilu": "nanek imi'na pacher kelli u'ñishala shanchushala.", "spanish": "entonces el cura ha traído santitos chiquititos."}
{"shiwilu": "enpinantek'unta'llina' dekshadeklusa',", "spanish": "las cuencas de las quebradas se secaron,"}
{"shiwilu": "luntulek kerka'lusa'", "spanish": "leo libros."}
{"shiwilu": "ta'ser kuanta' papinkuku'lusa' laukdeklek, wilakuñamu,", "spanish": "cuando contaban yo también a los abuelos ya finados les he escuchado."}
{"shiwilu": "nana yadi'setchusik.", "spanish": "cuando ya iba a empezar el fuego."}
{"shiwilu": "¡mupalli!", "spanish": "¡perfecto!"}
{"shiwilu": "kenmu'sak lli'i'nupalekwa'", "spanish": "somos egoístas."}
{"shiwilu": "yen'nitulek pen'nu'ak'", "spanish": "puedo volar."}
