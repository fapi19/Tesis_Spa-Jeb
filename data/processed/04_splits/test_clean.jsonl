{"shiwilu": "iyatudeklek", "spanish": "me gustan."}
{"shiwilu": "aden'cher'", "spanish": "vuelve."}
{"shiwilu": "kinekla' ñapallina'", "spanish": "están dentro."}
{"shiwilu": "¿yennitula lunta'mak?", "spanish": "¿puedes leer?"}
{"shiwilu": "neriker' u'chimu", "spanish": "respira normal."}
{"shiwilu": "tantenñi tuluker'ak", "spanish": "ama cantar."}
{"shiwilu": "iin nuka'kawa", "spanish": "somos hermanos."}
{"shiwilu": "luwantulek asu'", "spanish": "necesito esto."}
{"shiwilu": "llinserchapalek", "spanish": "estoy pintando."}
{"shiwilu": "¿yunsansu' ñapala?", "spanish": "¿estás levantado?"}
{"shiwilu": "nana uk'lli", "spanish": "él vino."}
{"shiwilu": "ipa'la asu' senñula' itullun ¡lunker shiwilu la'la'!", "spanish": "ahora esta señora me pidió ¡habla la lengua shiwilu!"}
{"shiwilu": "wanerker'", "spanish": "parate"}
{"shiwilu": "yawencha'ta", "spanish": "no vengas."}
{"shiwilu": "wa'an, panpadek di'setchullina', iñer uki'tapilallina'. purwanlusa' itullima.", "spanish": "jefe, han quemado pampayacu, todos están pereciendo quemados. los que pescaban dijeron."}
{"shiwilu": "a'ñiwinek nanasa'", "spanish": "tuve suficiente."}
{"shiwilu": "¡tekkinchi nuka'a!", "spanish": "¡es verdad!"}
{"shiwilu": "yainyututa", "spanish": "no discutas."}
{"shiwilu": "tekinchilusa' nuker'ka", "spanish": "son correctos."}
{"shiwilu": "aner nanalupa' yapa'tama tullima ala'sa' papinkusha.", "spanish": "no se vayan por ese camino decía un abuelito."}
{"shiwilu": "ipa'la tupiter'", "spanish": "ahora sigue."}
{"shiwilu": "nana nu'su' aku'llinerkenmu'wa'.", "spanish": "así nos han puesto."}
{"shiwilu": "tom lamapu'lli", "spanish": "tom gritó."}
{"shiwilu": "yamerladaper'i'la", "spanish": "sigue sonriendo."}
{"shiwilu": "¿napi'lanlek a'ta' na'wa' saka'tukellina'?.", "spanish": "¿acaso desde antes, pues, ellos han venido a trabajar?"}
{"shiwilu": "kala ukllima lli'chinpu'a'ser, wa'an peklu'deklli ñinanlu' nanapu'si'la.", "spanish": "como después de tres días no aparecieron, el gobernante convocó al pueblo."}
{"shiwilu": "asu' analli", "spanish": "esto apesta."}
{"shiwilu": "ilanñi", "spanish": "le disparó."}
{"shiwilu": "tanteñek", "spanish": "lo amo."}
{"shiwilu": "pilli'pi ñapalekwa'", "spanish": "estamos atrapados."}
{"shiwilu": "tom lachek'lli", "spanish": "tom entendió."}
{"shiwilu": "yatumu'ta", "spanish": "no mientas."}
{"shiwilu": "yalli'tama", "spanish": "no miren."}
{"shiwilu": "pata'ker' asu'", "spanish": "usa esto."}
{"shiwilu": "yennitulek'wa' katu'pa'a'kik", "spanish": "podemos ayudarte."}
{"shiwilu": "tumu'tulun", "spanish": "me mentiste."}
