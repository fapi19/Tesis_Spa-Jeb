{"shiwilu": "insilan nuka'kawa'", "spanish": "somos gemelos."}
{"shiwilu": "ipa'la nu'amu asek ñapalek.", "spanish": "por eso ahora estoy aquí."}
{"shiwilu": "lu'uktutek'ken ñiker", "spanish": "sé confiado."}
{"shiwilu": "nu'ter' ipia'lashinchi", "spanish": "hazlo ahoritita."}
{"shiwilu": "lanla' i'na di'tulli marceller,", "spanish": "a la ballena la mató marcel,"}
{"shiwilu": "pa'llina'. pa'anna' erwa uncha'llina'.", "spanish": "se van. luego de ir vienen tarde."}
{"shiwilu": "si'lentapallidek", "spanish": "estamos bromeando."}
{"shiwilu": "lu'wanwinek", "spanish": "lo extrañaba."}
{"shiwilu": "nalamulu'lusa' nakutusu', kekkilu'tek kawima uluntulli.", "spanish": "sobrepasaba las copas de los árboles, muy cerca del cielo ardía."}
{"shiwilu": "llinse'cher' manen'unta'", "spanish": "escribe algo."}
{"shiwilu": "mulunsha nuka'a", "spanish": "es guapa."}
{"shiwilu": "dek'awa'", "spanish": "votemos."}
{"shiwilu": "dakutan inchilalak anu'lli nana lantekpi.", "spanish": "avergonzado, en un desnivel del camino se cayó el canasto."}
{"shiwilu": "luanpi nuka'ka", "spanish": "soy amada."}
{"shiwilu": "ya'wencha'lli", "spanish": "quiere venir."}
{"shiwilu": "¿nu'pachin ma'nen?", "spanish": "¿entonces qué?"}
{"shiwilu": "amilusi'ma' willekllina' ukki'lanna'.", "spanish": "las viejitas lloraban de hambre."}
{"shiwilu": "¡nantapiteklusa'sa' nanpii tan ima asu' chilenllupa' nanpilusa' lliketchuduwidillekllina'.", "spanish": "¡que vivan puros fuerzudos! diciendo a los que viven por el barrio bajo casi los han exterminado."}
{"shiwilu": "lli'taper'i'la", "spanish": "sigue mirando."}
{"shiwilu": "kishu", "spanish": "jesús."}
{"shiwilu": "pulunker'wanpalli", "spanish": "está nevando."}
{"shiwilu": "perwatendusu' ñapalek", "spanish": "estoy desesperado."}
{"shiwilu": "uku'latapalli wayupilusa'", "spanish": "vende frutas."}
{"shiwilu": "kua lamapu'lek", "spanish": "yo grité."}
{"shiwilu": "tekua'dande'ku", "spanish": "soy tímido."}
{"shiwilu": "ali'la ku'apellek nanpillina' musu'.", "spanish": "con otra mujer vivían bien."}
{"shiwilu": "ta'tula'shasu' lunker'", "spanish": "habla bajito."}
{"shiwilu": "napi' taserpiku'lusa' luwanchiñina' kawita'kasu' wilakudek ña'sekkudek.", "spanish": "antes los viejos ya finados no querían que nos acercáramos cuando éramos niños."}
{"shiwilu": "tekker'", "spanish": "¡corre!"}
{"shiwilu": "wintetchenma' lantekpi dekkunta'su' napi'.", "spanish": "les voy a contar del canasto que caminaba antiguamente."}
{"shiwilu": "nanekla amitullinerku.", "spanish": "después me hicieron abuela."}
{"shiwilu": "yennitulek a'nañiak", "spanish": "puedo compartir."}
{"shiwilu": "yaintekllitulek", "spanish": "quiero jugar."}
{"shiwilu": "nu'sui'ma luñi taserpiku'lusa'.", "spanish": "así hablaron los antiguos…."}
{"shiwilu": "asu', tullima.", "spanish": "este, dijo."}
{"shiwilu": "ñinchitapalekwa' ali'ladaperunta' nanpi'perkasu', ñi'na ñienpi' lli'dek'i'nekwa'.", "spanish": "sabemos que otros también viven, pero nunca les hemos visto."}
{"shiwilu": "pacher' pipek'anna' kerapencha'llina' ¿ipa'li'na denler pacher' pipek'apetchu?, tullina'.", "spanish": "al cura cargándolo en la espalda lo traían ¿ahora quién va a estar cargando al cura?, dijeron."}
{"shiwilu": "nu'siklimaka asu' muyunpa inchilala nu'tullina'.", "spanish": "de esa manera construyeron el camino de moyobamba."}
{"shiwilu": "tumu'tuleklek", "spanish": "les mentí."}
{"shiwilu": "pinter ima sekmu'lli papinku.", "spanish": "diluyó tabaco el viejo."}
{"shiwilu": "ñinchitapalek lun'ak", "spanish": "sé leer."}
{"shiwilu": "ala' kilu inyalek chiter inyalalanantekkek.", "spanish": "un kilo de maíz se tuesta en una tostadora."}
{"shiwilu": "lunes nuka'a", "spanish": "es lunes."}
{"shiwilu": "mula'si'la asu' kai kua nerñinanlukla,", "spanish": "para bien esta hermana desde otro pueblo,"}
{"shiwilu": "¡kananekwa'!", "spanish": "¡lo logramos!"}
{"shiwilu": "yamer", "spanish": "sonríe."}
{"shiwilu": "wanerawa' asek", "spanish": "paremos aquí."}
{"shiwilu": "¡wek'lli!", "spanish": "¡ha venido!"}
{"shiwilu": "luwer'chulek", "spanish": "lo reconozco."}
{"shiwilu": "japones nuka'ka", "spanish": "soy japonés."}
{"shiwilu": "ipa'li'na ¿pa'apilala, kunpá? tan nakutulli, lli'ladeinpu'la'pi'.", "spanish": "ahora ¿estás yendo compadre? diciendo pasan, sin mirarle la cara."}
{"shiwilu": "naneklima adencha'a'ser lekdekllina' ¿enñupa' i'na kenmama' nanpikunama', pa'anma' mutupik?", "spanish": "de ahí, cuando regresaron les preguntaron ¿dónde se han ido a vivir ustedes, yéndose al cerro?"}
{"shiwilu": "ipa'la asu' shaya'lusa' inllinsellina' asu' ladanenna'.", "spanish": "ahora las mujeres se pintan sus caras."}
{"shiwilu": "¿den wer'lli?", "spanish": "¿quién desapareció?"}
{"shiwilu": "da'wanler kiteklli tatawek.", "spanish": "la víbora mordió a mi padre."}
{"shiwilu": "mapa'tapalek", "spanish": "estoy comprando."}
{"shiwilu": "nu'wanker'", "spanish": "baje."}
{"shiwilu": "nerpi'pu' uchinañinerkudek lauk'a'kudek, imanankankantullidek lauk'amudek.", "spanish": "a veces nos despiertan para que escuchemos y nos asustamos6 cuando escuchamos."}
{"shiwilu": "nana katu'pa'techu", "spanish": "eso ayudará."}
{"shiwilu": "nu'amu du'apalek.", "spanish": "por eso estoy sentada."}
{"shiwilu": "kana'ta'kawa'su' ñapalli", "spanish": "deberíamos ganar."}
{"shiwilu": "inmusha'iteklatanna', wellekllina'.", "spanish": "besándose las manos, lloraban."}
{"shiwilu": "¿wicha'palli?", "spanish": "¿está durmiendo?"}
{"shiwilu": "pulunker'apawiñi", "spanish": "nevaba."}
{"shiwilu": "yen'nichi'nek", "spanish": "estoy ocupado."}
{"shiwilu": "nu'ak kua' insekluten'apalekwa'.", "spanish": "por eso estamos sufriendo."}
{"shiwilu": "¿iya'tulama?", "spanish": "¿les gustó?"}
{"shiwilu": "empu'ni lli'inek", "spanish": "qué raro."}
{"shiwilu": "tullima nana lunanpichita'su', tullima nana wa'lata'su':", "spanish": "cuentan que dijo así el hombre que detectó, eso dijo ese soñador:"}
{"shiwilu": "ñaper' lu'uk'tan", "spanish": "estate atento."}
{"shiwilu": "luantullien", "spanish": "te amo."}
{"shiwilu": "ku'la nakui'nchu", "spanish": "prohibido pasar."}
{"shiwilu": "¡kana'tullidek!", "spanish": "¡hemos ganado!"}
{"shiwilu": "nu'amui'na kuanta' musu' nanpiapalek.", "spanish": "así yo también vivo bien."}
{"shiwilu": "ipa'linchi ukdinu'tulek.", "spanish": "entonces se empieza a mascar formando líquido."}
{"shiwilu": "tom malla'lli", "spanish": "tom rezó."}
{"shiwilu": "paker' kinekla", "spanish": "ve adentro."}
{"shiwilu": "a'pawileklli", "spanish": "ha cambiado."}
{"shiwilu": "ñapawiñina' kaluwi'su'", "spanish": "estaban enfermos."}
{"shiwilu": "nu'an imaka samellusa' yu'nketllina',", "spanish": "por eso dice los peces salieron,"}
{"shiwilu": "llinsercher' kerka'lusa'", "spanish": "escribe libros."}
{"shiwilu": "dankumelli arakayuler lli'apasik.", "spanish": "se hundió mientras arákayu la estaba mirando."}
{"shiwilu": "luwantullidek", "spanish": "lo necesitamos."}
{"shiwilu": "iya'linchi muinchi kua insekluten'amu wilaweklusa' a'ñinchillintudeklek.", "spanish": "entonces, mucho he sufrido para hacer educar a mis hijos."}
{"shiwilu": "- ñi asu' penweklek akusuchi'nchuma'.", "spanish": "con mi candela no van a cocinar."}
{"shiwilu": "yamerladaku'", "spanish": "sonrian."}
{"shiwilu": "ipa'li'na ma'nen llillinlusi'pa' aku'llina'.", "spanish": "ahora cualquier nombre ya les ponen."}
{"shiwilu": "uki'latek ñapallidek", "spanish": "estamos hambrientos."}
{"shiwilu": "yamerlek'wa'", "spanish": "nos reímos."}
{"shiwilu": "sha'pi'su'sa' nuker'ka", "spanish": "son amarillas."}
{"shiwilu": "ipa'linchi kelluluñiñi'pa' ñapa'n, inlli'inuku', ya'nlli'tapi'ñi a'pinta'.", "spanish": "ahora tal vez sólo el tigre negro hay, tengan mucho cuidado, no se deja ver más."}
{"shiwilu": "u'wa'tak analli", "spanish": "fumar apesta."}
{"shiwilu": "kua usha'wanek a'lek'inpu'dek'amu wilaweklusa'.", "spanish": "yo tengo la culpa de no haberles enseñado a mis hijos."}
{"shiwilu": "a'nakuker'", "spanish": "hazle pasar."}
{"shiwilu": "uku'latak nuker'ka", "spanish": "son negocios."}
{"shiwilu": "aner yawellektama'!", "spanish": "no lloren!"}
{"shiwilu": "¿tekinchi'cha' ñapala?", "spanish": "¿está seguro?"}
{"shiwilu": "¡tante'ñek!", "spanish": "¡lo adoro!"}
{"shiwilu": "mu'su' ñapala", "spanish": "estás bien."}
{"shiwilu": "inlli'inuker'", "spanish": "piénsatelo."}
{"shiwilu": "ipia'la yennichi'ñi", "spanish": "está ocupado."}
{"shiwilu": "¡musa'ka'tuna!", "spanish": "¡buen trabajo!"}
{"shiwilu": "luwantulek dek'", "spanish": "necesito agua."}
{"shiwilu": "¿den uk'lli?", "spanish": "¿quién vino?"}
{"shiwilu": "inlli'inuter' musuk", "spanish": "sé positivo."}
{"shiwilu": "muuklli", "spanish": "buenos días."}
{"shiwilu": "lli'amudek mu'katapa'su' penpen.", "spanish": "divisando lo que levanta humo tu candela."}
{"shiwilu": "nu'unta' latekta'sui'ma ekpa'n sha'wan uku'latukun, enpu'nipa' kulliker enka'llina'.", "spanish": "algunos que obedecieron llevaron a sus hermanas, las llevaron a vender, y les dieron mucho dinero."}
{"shiwilu": "nu'techun tuwina", "spanish": "prometiste."}
{"shiwilu": "makek saka'tapi'nek", "spanish": "estoy desempleado."}
{"shiwilu": "inyutapallina'", "spanish": "están discutiendo."}
{"shiwilu": "kera'pilellek la'la'lusa'", "spanish": "traigo noticias."}
{"shiwilu": "teklerier' ninchita'mak", "spanish": "adivina."}
{"shiwilu": "tekkinchintana kua ñinchitulek shiwilu la'la'.", "spanish": "verdaderamente yo he aprendido la lengua shiwilu."}
{"shiwilu": "turka nuka'ka", "spanish": "soy turca."}
{"shiwilu": "-yaluwer'amudek ukllidek.", "spanish": "-queriendo conocer hemos venido."}
{"shiwilu": "nu'akkui'na kenmu'wa' ipa'la tapalekwa' ali'la muda'nti'pa' nanpipalli,", "spanish": "por eso nosotros ahora decimos otra gente también quizá vivirán,"}
{"shiwilu": "¿weia'cha ñapalli?", "spanish": "¿está lejos?"}
{"shiwilu": "dudinpu' ñiwiñi nanek, ta'ser lauktulek.", "spanish": "toda cosa había ahí, cuando han dicho he escuchado."}
{"shiwilu": "¿den tenmian'su'lli?", "spanish": "¿quién parte?"}
{"shiwilu": "¿luuktek' nukama?", "spanish": "¿eres sordo?"}
{"shiwilu": "nu'wanker' asek", "spanish": "baja aquí."}
{"shiwilu": "adanta'a'kasu' ñapalli", "spanish": "debo regresar."}
{"shiwilu": "sanek'wantuwinek", "spanish": "tenía frío."}
{"shiwilu": "ipa' ñinchitulek", "spanish": "ya sé."}
{"shiwilu": "tekkinchi ala'sa' dadapu mudi'ma lli'tulli. lli'anna' imanantullina', lli'anna' ñi enpi' lli'inpu'erkasu'.", "spanish": "ahí efectivamente apareció un hombre blanco. al verlo se asustaron de ver lo que nunca antes habían visto."}
{"shiwilu": "llia'awa' asek", "spanish": "quedémonos acá."}
{"shiwilu": "nanek ima ñikuñi laweklateklusa'.", "spanish": "ahí se fueron a vivir los laulates12."}
{"shiwilu": "papinkumapu'wa'ku' tanni'ma nana luyurka'su', luyullinerkenmu'wa', tanni'ma pa'llina'.", "spanish": "nuestros abuelos finados dijeron que los que aborrecían, los que nos aborrecían, diciendo se fueron."}
{"shiwilu": "weranker' uti'la", "spanish": "come despacio."}
{"shiwilu": "adenche'chek", "spanish": "volveré."}
{"shiwilu": "musu' dek'la", "spanish": "¡buen tiro!"}
{"shiwilu": "musha'lli", "spanish": "la besó."}
{"shiwilu": "kulliker'wanpalek", "spanish": "tengo dinero."}
{"shiwilu": "tullina' napi' papinkuku'lusa', amiku'lusa', ikineklli walek uwenna'.", "spanish": "así han dicho antes los abuelos, las abuelas, tomando hasta la medianoche."}
{"shiwilu": "nalu' nuka'a", "spanish": "es nuevo."}
